datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  ARRIVED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum TokenStatus {
  WAITING
  IN_TRIAGE
  WITH_DOCTOR
  COMPLETED
  SKIPPED
  CANCELLED
}

enum PaymentMode {
  UPI
  CASH
  DEBIT_CARD
  CREDIT_CARD
  NET_BANKING
  INSURANCE_TPA
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  DRAFT
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PrescriptionStatus {
  ACTIVE
  FILLED
  COMPLETED
  CANCELLED
}


model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  role         Role       @default(PATIENT)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  patient Patient?
  doctor  Doctor?

  @@map("users")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors      Doctor[]
  appointments Appointment[]

  @@map("departments")
}

model Patient {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientNumber    String   @unique
  uhid             String?  @unique
  mrn              String?  @unique
  firstName        String
  lastName         String
  dateOfBirth      String
  gender           Gender   @default(MALE)
  phone            String
  address          String
  addressLine      String?
  locality         String?
  city             String?
  district         String?
  state            String?
  pincode          String?
  emergencyContact String
  bloodGroup       String?
  aadhaarNumber    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments  Appointment[]
  opdTokens     OPDToken[]
  consultations Consultation[]
  invoices      Invoice[]
  prescriptions Prescription[]

  @@map("patients")
}

model Doctor {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorNumber   String     @unique
  firstName      String
  lastName       String
  specialization String
  qualification  String
  licenseNumber  String     @unique
  phone          String
  bio            String
  profileImage   String?
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  experience     Int        @default(5)
  status         Status     @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  appointments  Appointment[]
  opdTokens     OPDToken[]
  consultations Consultation[]
  prescriptions Prescription[]

  @@map("doctors")
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointmentDate String
  startTime       String
  endTime         String?
  type            String            @default("NEW_CONSULTATION")
  status          AppointmentStatus @default(CONFIRMED)
  reason          String
  tokenNumber     String?
  notes           String?
  fee             Float             @default(500)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  opdToken     OPDToken?
  consultation Consultation?
  prescription Prescription?
  invoices     Invoice[]

  @@map("appointments")
}

model OPDToken {
  id             String      @id @default(uuid())
  appointmentId  String?     @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  tokenNumber    String
  sequenceNumber Int
  tokenDate      String
  status         TokenStatus @default(WAITING)
  calledAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("opd_tokens")
}

model Consultation {
  id             String       @id @default(uuid())
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  chiefComplaint String
  diagnosis      String
  visualAcuityOD String?
  visualAcuityOS String?
  iopOD          String?
  iopOS          String?
  clinicalNotes  String?
  treatmentPlan  String?
  status         String       @default("COMPLETED")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  prescription Prescription?
  invoice      Invoice?

  @@map("consultations")
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId   String?
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  consultationId  String?       @unique
  consultation    Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  prescriptionId  String?       @unique
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  serviceName     String
  subtotal        Float
  discount        Float         @default(0)
  tax             Float         @default(0)
  totalAmount     Float
  amountPaid      Float         @default(0)
  amountDue       Float         @default(0)
  paymentMode     PaymentMode   @default(UPI)
  status          PaymentStatus @default(PENDING)
  notes           String?
  refundStatus    String?
  refundAmount    Float         @default(0)
  refundedAt      DateTime?
  tpaClaimId      String?
  tpaApprovalCode String?
  issuedAt        DateTime      @default(now())
  dueDate         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items    InvoiceItem[]
  payments PaymentRecord[]

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@index([patientId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  category    String   @default("CONSULTATION")
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentRecord {
  id               String      @id @default(uuid())
  paymentNumber    String      @unique
  invoiceId        String
  invoice          Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           Float
  paymentMode      PaymentMode @default(UPI)
  transactionRef   String?
  notes            String?
  receivedByUserId String?
  createdAt        DateTime    @default(now())

  @@index([invoiceId])
  @@map("payment_records")
}

model Prescription {
  id                 String             @id @default(uuid())
  prescriptionNumber String             @unique
  patientId          String
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId           String
  doctor             Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointmentId      String?            @unique
  appointment        Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  consultationId     String?            @unique
  consultation       Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  issuedAt           DateTime           @default(now())
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items   PrescriptionItem[]
  invoice Invoice?

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
  @@index([patientId, status])
  @@index([doctorId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String
  frequency      String
  route          String       @default("TOPICAL_EYE")
  duration       String
  instructions   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([prescriptionId])
  @@map("prescription_items")
}

